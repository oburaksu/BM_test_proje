# =============================================
# Çevre Değişkenleri (Environment Variables)
# Bu dosyayı .env olarak kopyalayarak kullanın
# =============================================

# Veritabanı bağlantı URL'si
# SQLite için: sqlite:///./todo.db
# PostgreSQL için: postgresql://user:password@localhost:5432/tododb
DATABASE_URL=sqlite:///./todo.db

# Uygulama ayarları
APP_NAME=To-Do List Manager
APP_VERSION=1.0.0
DEBUG=true

# Sunucu ayarları
HOST=0.0.0.0
PORT=8000
